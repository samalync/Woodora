<%- include('partials/header') %>
<section class="auth-split">
    <div class="auth-visual" style="background-image: url('/images/utensil-holder.jpeg')">
        <div class="auth-visual-text">
            <h2>Join Woodora</h2>
            <p>Create an account to order natural wooden kitchenware and track your deliveries.</p>
        </div>
    </div>
    <div class="auth-panel">
        <div class="auth-form">
            <h1>Create your account</h1>
            <p class="muted">Customer accounts only.</p>
            <%- include('partials/error-summary', { errors }) %>
            <form action="/register" method="post" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <%- include('partials/field', { name: 'name', label: 'Full name', type: 'text', values, errors, attrs: 'required maxlength="60" autocomplete="name"' }) %>
                <%- include('partials/field', { name: 'email', label: 'Email', type: 'email', values, errors, attrs: 'required maxlength="100" autocomplete="email"' }) %>
                <%- include('partials/field', { name: 'password', label: 'Password', type: 'password', values, errors, hint: 'At least 8 characters, with a letter and a number.', attrs: 'required autocomplete="new-password"' }) %>
                <%- include('partials/field', { name: 'confirm', label: 'Confirm password', type: 'password', values, errors, attrs: 'required autocomplete="new-password"' }) %>
                <button type="submit" class="btn btn-block btn-large">Create account</button>
            </form>
            <p class="form-footer">Already registered? <a href="/login/customer">Log in</a></p>
        </div>
    </div>
</section>
<%- include('partials/footer') %>
