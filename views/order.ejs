<%- include('partials/header') %>
<section class="page-hero compact">
    <h1>Order #<%= order.id %></h1>
    <%- include('partials/checkout-steps', { step: (order.payment_status === 'Paid' || order.payment_method === 'cod') ? 4 : 3 }) %>
    <p><%- include('partials/status-badges', { order: order }) %></p>
</section>
<%
const isCod = order.payment_method === 'cod';
const isDelivered = order.order_status === 'Delivered';
const isConfirmed = order.payment_status === 'Paid' || isCod;
%>
<% if (isConfirmed) { %>
<section class="section confirm-section">
    <div class="confirm">
        <span class="confirm-icon"><%- include('partials/icon', { name: 'check' }) %></span>
        <div class="confirm-text">
            <% if (isDelivered) { %>
                <h2>Your order has been delivered</h2>
                <p>Thank you for choosing Woodora, <%= order.customer_name %>. We hope you enjoy your wooden pieces.</p>
            <% } else { %>
                <h2>Thank you, <%= order.customer_name %>! We have your order.</h2>
                <p><%= isCod && order.payment_status !== 'Paid' ? 'You pay in cash when it arrives, so there is nothing more to do now.' : 'Your simulated payment went through. No real money was charged.' %></p>
                <ol class="confirm-next">
                    <li>We prepare your order.</li>
                    <li>We deliver it to <%= order.address %>, <%= order.city %>.</li>
                    <li>You can follow its status any time in My Orders.</li>
                </ol>
            <% } %>
            <div class="button-row">
                <a href="/orders" class="btn">View My Orders</a>
                <a href="/products" class="btn btn-outline">Continue shopping</a>
            </div>
        </div>
    </div>
</section>
<% } %>
<section class="section checkout-layout">
    <div class="card">
        <h2>Items</h2>
        <ul class="summary-list">
            <% items.forEach(function (item) { %>
                <li><span><%= item.product_name %> <small class="muted">&times; <%= item.quantity %> (<%= rwf(item.unit_price) %> each)</small></span><strong><%= rwf(item.unit_price * item.quantity) %></strong></li>
            <% }) %>
        </ul>
        <p class="row cart-total"><span>Total</span><strong><%= rwf(order.total) %></strong></p>
        <% if (order.payment_status === 'Unpaid' && order.payment_method !== 'cod') { %>
            <p><a href="/orders/<%= order.id %>/pay" class="btn">Pay now (simulated)</a></p>
        <% } %>
        <% if (order.payment_method === 'cod' && order.payment_status === 'Unpaid') { %>
            <p class="notice">Cash on Delivery: please pay <%= rwf(order.total) %> in cash when your order arrives.</p>
        <% } %>
    </div>
    <aside class="card summary">
        <h2>Delivery details</h2>
        <p><strong><%= order.customer_name %></strong></p>
        <p><%= order.address %>, <%= order.city %></p>
        <p>Phone: <%= order.phone %></p>
        <p>Email: <%= order.email %></p>
        <p>Payment: <%= methodName %></p>
        <p>Placed: <%= order.created_at %></p>
        <p><a href="/orders">&larr; All my orders</a></p>
    </aside>
</section>
<%- include('partials/footer') %>
