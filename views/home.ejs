<%- include('partials/header') %>

<div class="hero-band">
<section class="hero">
    <div class="hero-content">
        <p class="small-title">WOODEN KITCHEN &middot; MINDFUL LIVING</p>
        <h1>Bring Nature Into Your Kitchen.</h1>
        <p class="hero-text">Discover beautiful wooden kitchen essentials that make everyday cooking feel more natural, thoughtful and meaningful.</p>
        <div class="button-row">
            <a href="/products" class="btn btn-large">Shop the Collection <%- include('partials/icon', { name: 'arrow' }) %></a>
            <a href="/mission" class="btn btn-outline btn-large">Our Story</a>
        </div>
        <ul class="hero-points">
            <li><%- include('partials/icon', { name: 'check' }) %> 100% natural wood</li>
            <li><%- include('partials/icon', { name: 'check' }) %> Made by local artisans</li>
            <li><%- include('partials/icon', { name: 'check' }) %> Mobile Money, card or cash</li>
        </ul>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <img class="hero-img hero-img-a" src="/images/utensil-holder.jpeg" alt="">
        <img class="hero-img hero-img-b" src="/images/cups.jpeg" alt="">
        <img class="hero-img hero-img-c" src="/images/bowl-set.jpeg" alt="">
        <div class="hero-badge"><%- include('partials/icon', { name: 'leaf' }) %> <span>Less plastic,<br>more nature</span></div>
    </div>
</section>
</div>

<section class="values">
    <div><%- include('partials/icon', { name: 'leaf' }) %><h3>Natural materials</h3><p>Responsibly sourced wood, finished with care.</p></div>
    <div><%- include('partials/icon', { name: 'hand' }) %><h3>Crafted by people</h3><p>Every purchase supports local makers.</p></div>
    <div><%- include('partials/icon', { name: 'truck' }) %><h3>Simple ordering</h3><p>Pay by Mobile Money, card or on delivery.</p></div>
</section>

<section class="section">
    <h2 class="section-title">Shop by category</h2>
    <p class="section-description">Find the right piece for cooking, serving and storing.</p>
    <div class="category-grid">
        <% categories.forEach(function (c) { %>
            <a href="/products?category=<%= c.id %>" class="category-tile">
                <img src="/images/<%= c.image %>" alt="" loading="lazy">
                <span class="category-label"><strong><%= c.name %></strong><small><%= c.count %> product<%= c.count === 1 ? '' : 's' %></small></span>
            </a>
        <% }) %>
    </div>
</section>

<section class="section" id="collection">
    <h2 class="section-title">Simple Pieces. Natural Beauty.</h2>
    <p class="section-description">Thoughtful wooden essentials for cooking, serving and sharing.</p>

    <div class="product-grid featured-grid">
        <% featured.forEach(function (product) { %>
            <%- include('partials/product-card', { product: product }) %>
        <% }) %>
    </div>
    <p class="center"><a href="/products" class="btn btn-outline">View all products</a></p>
</section>

<section class="how">
    <h2 class="section-title">How it works</h2>
    <div class="steps">
        <div><span>1</span><h3>Choose</h3><p>Browse our wooden collection and add your favourites to the cart.</p></div>
        <div><span>2</span><h3>Check out</h3><p>Enter your delivery details and pick Mobile Money, card or cash on delivery.</p></div>
        <div><span>3</span><h3>Receive</h3><p>Follow your order status any time from the My Orders page.</p></div>
    </div>
</section>

<section class="dark-band">
    <p class="small-title light">OUR IMPACT</p>
    <h2>Better Choices Begin With Everyday Moments.</h2>
    <a href="/impact" class="btn btn-gold btn-large">Discover Our Impact</a>
</section>

<%- include('partials/footer') %>
