<%- include('partials/header') %>
<%
const out = product.stock === 0;
const low = product.stock > 0 && product.stock <= 5;
%>
<section class="section">
    <p class="breadcrumb"><a href="/products">Products</a> <span>/</span> <a href="/products?category=<%= product.category_id %>"><%= product.category %></a> <span>/</span> <%= product.name %></p>

    <div class="detail">
        <div class="detail-image"><img src="/images/<%= product.image %>" alt="<%= product.name %>"></div>
        <div class="detail-info">
            <p class="product-category"><%= product.category %></p>
            <h1><%= product.name %></h1>
            <p class="detail-price"><%= rwf(product.price) %></p>
            <p class="detail-description"><%= product.description %></p>
            <p class="stock-pill <%= out ? 'stock-out' : (low ? 'stock-low' : 'stock-ok') %>">
                <span class="dot"></span>
                <%= out ? 'Out of stock' : (low ? 'Only ' + product.stock + ' left in stock' : 'In stock - ' + product.stock + ' available') %>
            </p>

            <% if (!out) { %>
                <form action="/cart/add" method="post" class="add-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    <input type="hidden" name="back" value="/products/<%= product.id %>">
                    <div class="field">
                        <label for="quantity">Quantity</label>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" max="<%= Math.min(product.stock, 20) %>">
                    </div>
                    <button type="submit" class="btn btn-large"><%- include('partials/icon', { name: 'cart' }) %> Add to Cart</button>
                </form>
            <% } %>

            <ul class="detail-points">
                <li><%- include('partials/icon', { name: 'leaf' }) %> Natural wood, no plastic</li>
                <li><%- include('partials/icon', { name: 'card' }) %> Pay with Mobile Money, card or cash (simulated)</li>
                <li><%- include('partials/icon', { name: 'truck' }) %> Delivery to your address</li>
            </ul>
            <p><a href="/products" class="back-link">&larr; Back to products</a></p>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
