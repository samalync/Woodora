<% if (flash) { %>
    <div class="flash flash-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
        <%- include('icon', { name: flash.type === 'error' ? 'alert' : 'check' }) %>
        <span><%= flash.text %></span>
        <button type="button" class="flash-close" aria-label="Dismiss message">&times;</button>
    </div>
<% } %>
