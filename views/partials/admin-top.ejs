<%# Opens the administrator layout: top bar + sidebar. Close it with admin-bottom.ejs. Needs: title, optional "section" (sidebar highlight) %>
<%- include('head') %>
<body class="admin-body">
<a class="skip-link" href="#main">Skip to content</a>

<header class="admin-topbar">
    <a href="/admin" class="logo logo-light" aria-label="Woodora admin">
        <svg class="logo-icon" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="19" fill="#c3a45d"/>
            <circle cx="20" cy="20" r="13" fill="none" stroke="#2b1f14" stroke-width="2"/>
            <circle cx="20" cy="20" r="7" fill="none" stroke="#2b1f14" stroke-width="2"/>
            <circle cx="20" cy="20" r="2" fill="#2b1f14"/>
        </svg>
        <span>Woodora</span><small class="admin-tag">Admin</small>
    </a>
    <div class="admin-topbar-actions">
        <%# Notification bell: the number comes from the server now and is refreshed by public/js/admin-notifications.js %>
        <div class="notif" data-notifications data-csrf="<%= csrfToken %>">
            <button type="button" class="notif-button" aria-haspopup="true" aria-expanded="false" aria-controls="notif-panel"
                    aria-label="Notifications, <%= unreadNotifications %> unread">
                <%- include('icon', { name: 'bell' }) %>
                <span class="notif-badge" data-notif-count <%= unreadNotifications === 0 ? 'hidden' : '' %>><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
            </button>
            <div class="notif-panel" id="notif-panel" hidden>
                <div class="notif-head">
                    <strong>Notifications</strong>
                    <button type="button" class="notif-markall" data-notif-readall>Mark all as read</button>
                </div>
                <ul class="notif-list" data-notif-list></ul>
                <a class="notif-foot" href="/admin/visitors">Open Website Visitors &rarr;</a>
            </div>
            <span class="sr-only" role="status" aria-live="polite" data-notif-announce></span>
        </div>
        <a href="/" target="_blank" rel="noopener" class="topbar-link"><%- include('icon', { name: 'store' }) %> View store</a>
        <span class="topbar-user"><%= currentUser.name %></span>
        <form action="/logout" method="post" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="topbar-link topbar-button"><%- include('icon', { name: 'logout' }) %> Log out</button>
        </form>
    </div>
</header>

<div class="admin-shell">
    <aside class="admin-sidebar">
        <nav aria-label="Admin">
            <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>"><%- include('icon', { name: 'dashboard' }) %> Dashboard</a>
            <a href="/admin/products" class="<%= currentPath.startsWith('/admin/products') ? 'active' : '' %>"><%- include('icon', { name: 'box' }) %> Products</a>
            <a href="/admin/orders" class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>"><%- include('icon', { name: 'orders' }) %> Orders</a>
            <a href="/admin/visitors" class="<%= currentPath.startsWith('/admin/visitors') ? 'active' : '' %>"><%- include('icon', { name: 'eye' }) %> Website Visitors</a>
            <a href="/admin/messages" class="<%= currentPath.startsWith('/admin/messages') ? 'active' : '' %>"><%- include('icon', { name: 'mail' }) %> Messages</a>
            <a href="/admin/payment-methods" class="<%= currentPath.startsWith('/admin/payment-methods') ? 'active' : '' %>"><%- include('icon', { name: 'card' }) %> Payment methods</a>
        </nav>
    </aside>
    <main id="main" class="admin-main">
        <%- include('flash') %>
