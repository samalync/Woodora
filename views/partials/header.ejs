<%- include('head') %>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<div class="topbar">University demo store &middot; online payments are simulated &mdash; no real money is charged</div>

<header class="site-header">
    <div class="header-inner">
        <a href="/" class="logo" aria-label="Woodora home">
            <!-- Logo icon: wood tree rings -->
            <svg class="logo-icon" viewBox="0 0 40 40" aria-hidden="true">
                <circle cx="20" cy="20" r="19" fill="#5b432e"/>
                <circle cx="20" cy="20" r="13" fill="none" stroke="#c3a45d" stroke-width="2"/>
                <circle cx="20" cy="20" r="7" fill="none" stroke="#c3a45d" stroke-width="2"/>
                <circle cx="20" cy="20" r="2" fill="#c3a45d"/>
            </svg>
            <span>Woodora</span>
        </a>

        <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
            <span></span><span></span><span></span>
        </button>

        <nav id="main-nav" class="main-nav" aria-label="Main">
            <div class="nav-links">
                <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
                <a href="/products" class="<%= currentPath.startsWith('/products') ? 'active' : '' %>">Products</a>
                <a href="/mission" class="<%= currentPath === '/mission' ? 'active' : '' %>">Our Mission</a>
                <a href="/impact" class="<%= currentPath === '/impact' ? 'active' : '' %>">Impact</a>
                <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
            </div>

            <div class="nav-actions">
                <a href="/cart" class="nav-cart <%= currentPath.startsWith('/cart') ? 'active' : '' %>">
                    <%- include('icon', { name: 'cart' }) %> Cart <span class="cart-badge"><%= cartCount %></span>
                </a>
                <% if (currentUser) { %>
                    <% if (currentUser.role === 'admin') { %>
                        <a href="/admin" class="btn btn-small">Admin dashboard</a>
                    <% } else { %>
                        <a href="/orders" class="<%= currentPath.startsWith('/orders') ? 'active' : '' %>">My Orders</a>
                    <% } %>
                    <form action="/logout" method="post" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="nav-button">Log out</button>
                    </form>
                <% } else { %>
                    <a href="/login" class="<%= currentPath.startsWith('/login') || currentPath === '/admin/login' ? 'active' : '' %>">Log in</a>
                    <a href="/register" class="btn btn-small">Sign up</a>
                <% } %>
            </div>
        </nav>
    </div>
</header>

<main id="main">
<%- include('flash') %>
