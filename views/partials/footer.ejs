                    <circle cx="20" cy="20" r="19" fill="#c3a45d"/>
                    <circle cx="20" cy="20" r="13" fill="none" stroke="#191919" stroke-width="2"/>
                    <circle cx="20" cy="20" r="7" fill="none" stroke="#191919" stroke-width="2"/>
                    <circle cx="20" cy="20" r="2" fill="#191919"/>
                </svg>
                <span>Woodora</span>
            </a>
            <p>Natural wooden essentials for a thoughtful kitchen.</p>
            <p class="pay-methods"><span>Mobile Money</span><span>Card</span><span>Cash on Delivery</span></p>
        </div>
        <div>
            <h3>Shop</h3>
            <p><a href="/products">All products</a></p>
            <p><a href="/cart">Shopping cart</a></p>
            <p><a href="/mission">Our Mission</a></p>
            <p><a href="/impact">Our Impact</a></p>
