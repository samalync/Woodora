                <p><a href="<%= currentUser.role === 'admin' ? '/admin' : '/orders' %>"><%= currentUser.role === 'admin' ? 'Admin dashboard' : 'My Orders' %></a></p>
            <% } else { %>
                <p><a href="/login/customer">Customer login</a></p>
