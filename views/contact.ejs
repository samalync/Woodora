<%- include('partials/header') %>
<section class="page-hero compact">
    <p class="small-title">GET IN TOUCH</p>
    <h1>Contact Us</h1>
    <p>Questions about an order or a product? Send us a message.</p>
</section>
<section class="section two-col">
    <div class="card form-card">
        <h2>Send us a message</h2>
        <%- include('partials/error-summary', { errors }) %>
        <form action="/contact" method="post" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field-row">
                <%- include('partials/field', { name: 'name', label: 'Your name', type: 'text', values, errors, attrs: 'required maxlength="60"' }) %>
                <%- include('partials/field', { name: 'email', label: 'Email', type: 'email', values, errors, attrs: 'required maxlength="100"' }) %>
            </div>
            <%- include('partials/field', { name: 'subject', label: 'Subject', type: 'text', values, errors, attrs: 'required maxlength="100"' }) %>
            <div class="field <%= errors.message ? 'has-error' : '' %>">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="6" required maxlength="1000" <%- errors.message ? 'aria-invalid="true" aria-describedby="message-error"' : '' %>><%= values.message %></textarea>
                <% if (errors.message) { %><p class="error-text" id="message-error"><%= errors.message %></p><% } %>
            </div>
            <button type="submit" class="btn btn-block btn-large">Send message</button>
        </form>
    </div>
    <div class="card info-card">
        <h2>Visit or call</h2>
        <% if (business.email) { %><p><%- include('partials/icon', { name: 'mail' }) %> <span><strong>Email</strong><br><%= business.email %></span></p><% } %>
        <p><%- include('partials/icon', { name: 'phone' }) %> <span><strong>Phone</strong><br><%= business.phone %></span></p>
        <p><%- include('partials/icon', { name: 'pin' }) %> <span><strong>Address</strong><br><%= business.address %></span></p>
        <p><%- include('partials/icon', { name: 'truck' }) %> <span><strong>Opening hours</strong><br><%= business.hours %></span></p>
    </div>
</section>
<%- include('partials/footer') %>
