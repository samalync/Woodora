# Copy this file to ".env" and change the values.
# Secret used to protect login sessions. Use a long random text.
SESSION_SECRET=change-this-to-a-long-random-text
# Administrator account created by "npm run setup".
# NOTE: do not use the # character in the password (it starts a comment in .env files),
# or put the whole password in "double quotes".
ADMIN_EMAIL=admin@woodora.example
ADMIN_PASSWORD=choose-your-own-strong-password
# Port the website runs on (on your computer)
PORT=3000

# --- Only needed when deploying to Vercel (leave empty on your own computer) ---
# Hosted database from https://turso.tech (Vercel cannot keep a database file).
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
